<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyERP</title>
    <link rel="icon" type="image/png" href="~/template/assets/images/favicon.png" />
    <link rel="stylesheet" href="~/template/dist/css/style.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/template/assets/libs/chartist/dist/chartist.min.css" />
    <link rel="stylesheet" href="~/template/assets/libs/chartist-plugin-tooltips/dist/chartist-plugin-tooltip.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body ng-app="erp" class="@(User.Identity != null && User.Identity.IsAuthenticated ? "" : "authentication-wrapper")">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div id="main-wrapper" data-layout="vertical" data-sidebartype="full">
            <partial name="_Header" />
            <partial name="_Sidebar" />
            <div class="page-wrapper">
                <partial name="_Breadcrumbs" />
                <div class="container-fluid">
                    <main role="main" class="pb-4">
                        @RenderBody()
                    </main>
                </div>
                <partial name="_Footer" />
            </div>
        </div>
    }
    else
    {
        <div id="main-wrapper" class="authentication-shell">
            <partial name="_Header" />
            <main role="main" class="authentication-content">
                @RenderBody()
            </main>
            <partial name="_Footer" />
        </div>
    }

    <script src="~/template/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/template/assets/libs/popper.js/dist/umd/popper.min.js"></script>
    <script src="~/template/assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
    <script src="~/js/erp.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/template/dist/js/app.min.js"></script>
    <script src="~/template/dist/js/app.init.js"></script>
    <script src="~/template/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
    <script src="~/template/dist/js/waves.js"></script>
    <script src="~/template/dist/js/sidebarmenu.js"></script>
    <script src="~/template/dist/js/custom.min.js"></script>
    <script src="~/template/assets/libs/chartist/dist/chartist.min.js"></script>
    <script src="~/template/assets/libs/chartist-plugin-tooltips/dist/chartist-plugin-tooltip.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

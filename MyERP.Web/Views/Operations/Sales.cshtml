@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-intro"><p>Create sales orders and dispatch only when stock is available.</p></div>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Message"]</div>
}
<div class="card operations-form-card mb-3">
    <div class="card-body">
        <div class="section-heading">
            <div><h2 class="section-title">New sales order</h2><p class="section-description">Select a branch and customer, then add the items to dispatch.</p></div>
            <i class="mdi mdi-cart-outline section-heading-icon"></i>
        </div>
        <form asp-action="Sales" method="post" ng-controller="documentLines">
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="control-label" for="salesOrderNumber">Order number <span class="required-mark">*</span></label>
                    <input id="salesOrderNumber" name="Input.Number" class="form-control" required maxlength="40" value="SO-@DateTime.UtcNow.ToString("yyyyMMdd-HHmmss")" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="control-label" for="salesOrderBranch">Branch <span class="required-mark">*</span></label>
                    <select id="salesOrderBranch" name="Input.BranchId" class="form-control" required>
                        <option value="">Select branch</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-group">
                    <label class="control-label" for="salesOrderCustomer">Customer <span class="required-mark">*</span></label>
                    <select id="salesOrderCustomer" name="Input.PartyId" class="form-control" required>
                        <option value="">Select customer</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-group">
                    <label class="control-label" for="salesOrderNotes">Notes</label>
                    <input id="salesOrderNotes" name="Input.Notes" class="form-control" maxlength="400" />
                </div>
            </div>
            <div class="section-heading mt-3">
                <div><h3 class="section-title">Order lines</h3><p class="section-description">Add each item, quantity, and selling price.</p></div>
            </div>
            <div class="table-responsive document-lines">
                <table class="table">
                    <thead><tr><th>Item</th><th>Quantity</th><th>Unit price</th><th></th></tr></thead>
                    <tbody>
                        <tr ng-repeat="line in lines">
                            <td>
                                <select class="form-control" ng-model="line.itemId" name="Input.Lines[{{$index}}].ItemId" required>
                                    <option value="">Select item</option>
                                    @foreach (var item in Model.Items)
                                    {
                                        <option value="@item.Id">@item.Code - @item.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" type="number" min="0.001" step="0.001" ng-model="line.quantity" name="Input.Lines[{{$index}}].Quantity" required /></td>
                            <td><input class="form-control" type="number" min="0" step="0.01" ng-model="line.unitPrice" name="Input.Lines[{{$index}}].UnitPrice" required /></td>
                            <td><button class="btn btn-sm btn-outline-danger" type="button" ng-click="removeLine($index)">Remove</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="form-action-row">
                <button type="button" class="btn btn-outline-primary" ng-click="addLine()">Add item</button>
                <button type="submit" class="btn btn-primary">Create sales order</button>
                <button type="button" class="btn btn-light" ng-click="resetForm($event)">Reset</button>
            </div>
        </form>
    </div>
</div>
<div class="card operation-table-card">
    <div class="card-body">
        <div class="section-heading"><div><h2 class="section-title">Sales orders</h2><p class="section-description">@Model.Rows.Count order(s)</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Order</th><th>Customer</th><th>Branch</th><th>Date</th><th>Status</th><th class="text-right">Action</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="font-weight-medium">@row.Number</td><td>@row.Party</td><td>@row.Branch</td><td>@row.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge text-bg-light status-pill">@row.Status</span></td>
                            <td class="text-right">
                                @if (row.Status == MyERP.Domain.WorkflowStatus.Approved)
                                {
                                    <form asp-action="Dispatch" method="post" class="form-inline-action"><input type="hidden" name="id" value="@row.Id" /><button class="btn btn-sm btn-primary" type="submit">Dispatch</button></form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="6" class="table-empty-state">No sales orders yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-intro">
    <p>Quantities are calculated from approved receipts, dispatches, and adjustments.</p>
    <div class="operations-page-actions"><a class="btn btn-outline-primary" asp-action="Adjustments"><i class="mdi mdi-tune"></i> Adjust stock</a></div>
</div>
<div class="card operation-table-card">
    <div class="card-body">
        <div class="section-heading"><div><h2 class="section-title">Stock on hand</h2><p class="section-description">@Model.Stock.Count item / branch balance(s)</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Branch</th><th>Item code</th><th>Item</th><th>On hand</th><th>Reorder level</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Stock)
                    {
                        <tr>
                            <td>@row.Branch</td><td>@row.ItemCode</td><td>@row.Item</td><td>@row.OnHand.ToString("N3")</td><td>@row.ReorderLevel.ToString("N3")</td>
                            <td>
                                @if (row.OnHand <= row.ReorderLevel)
                                {
                                    <span class="badge text-bg-warning">Reorder</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">In stock</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Stock.Any())
                    {
                        <tr><td colspan="6" class="table-empty-state">No inventory transactions have been posted.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Stock on hand</h1><p class="text-muted mb-0">Quantities are calculated from approved receipts, dispatches and adjustments.</p></div><a class="btn btn-outline-primary" asp-action="Adjustments">Adjust stock</a></div>
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between mb-3"><strong>@Model.Stock.Count item / branch balances</strong></div>
    <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Branch</th><th>Item code</th><th>Item</th><th>On hand</th><th>Reorder level</th><th>Status</th></tr></thead><tbody>
    @foreach (var row in Model.Stock)
    {
        <tr><td>@row.Branch</td><td>@row.ItemCode</td><td>@row.Item</td><td>@row.OnHand.ToString("N3")</td><td>@row.ReorderLevel.ToString("N3")</td><td>@if (row.OnHand <= row.ReorderLevel) { <span class="badge text-bg-warning">Reorder</span> } else { <span class="badge text-bg-success">In stock</span> }</td></tr>
    }
    @if (!Model.Stock.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No inventory transactions have been posted.</td></tr> }
    </tbody></table></div>
</div></div>

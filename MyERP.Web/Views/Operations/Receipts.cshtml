@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-intro">
    <p>Receive approved purchase order quantities and post stock after approval.</p>
    <div class="operations-page-actions"><a asp-action="NewReceipt" class="btn btn-primary"><i class="mdi mdi-plus"></i> Receive goods</a></div>
</div>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}
<div class="card operation-table-card">
    <div class="card-body">
        <div class="section-heading"><div><h2 class="section-title">Goods receipts</h2><p class="section-description">@Model.Rows.Count receipt(s)</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Receipt</th><th>Purchase order</th><th>Branch</th><th>Received</th><th>Status</th><th class="text-right">Action</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="font-weight-medium">@row.Number</td><td>@row.Party</td><td>@row.Branch</td><td>@row.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge text-bg-light status-pill">@row.Status</span></td>
                            <td class="text-right">
                                @if (row.Status == MyERP.Domain.WorkflowStatus.Submitted)
                                {
                                    <form asp-action="ReviewReceipt" method="post" class="form-inline-action"><input type="hidden" name="id" value="@row.Id" /><input type="hidden" name="approve" value="true" /><button class="btn btn-sm btn-success">Approve &amp; post stock</button></form>
                                    <form asp-action="ReviewReceipt" method="post" class="form-inline-action"><input type="hidden" name="id" value="@row.Id" /><input type="hidden" name="approve" value="false" /><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="6" class="table-empty-state">No receipts yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

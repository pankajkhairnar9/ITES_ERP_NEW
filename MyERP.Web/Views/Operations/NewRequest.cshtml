@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-intro"><p>Submitting a request sends it into the approval workflow.</p></div>
<div class="card operations-form-card">
    <div class="card-body">
        <form asp-action="NewRequest" method="post" ng-controller="documentLines">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="control-label" for="requestNumber">Request number <span class="required-mark">*</span></label>
                    <input id="requestNumber" name="Input.Number" class="form-control" required maxlength="40" value="PR-@DateTime.UtcNow.ToString("yyyyMMdd-HHmmss")" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="control-label" for="requestBranch">Branch <span class="required-mark">*</span></label>
                    <select id="requestBranch" name="Input.BranchId" class="form-control" required>
                        <option value="">Select branch</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="control-label" for="requestNotes">Notes</label>
                    <input id="requestNotes" name="Input.Notes" class="form-control" maxlength="400" />
                </div>
            </div>
            <div class="section-heading mt-3">
                <div><h2 class="section-title">Request items</h2><p class="section-description">Choose item quantities and estimated prices.</p></div>
            </div>
            <div class="table-responsive document-lines">
                <table class="table">
                    <thead><tr><th>Item</th><th>Quantity</th><th>Estimated unit price</th><th></th></tr></thead>
                    <tbody>
                        <tr ng-repeat="line in lines">
                            <td>
                                <select class="form-control" ng-model="line.itemId" name="Input.Lines[{{$index}}].ItemId" required>
                                    <option value="">Select item</option>
                                    @foreach (var item in Model.Items)
                                    {
                                        <option value="@item.Id">@item.Code - @item.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control" type="number" step="0.001" min="0.001" ng-model="line.quantity" name="Input.Lines[{{$index}}].Quantity" required /></td>
                            <td><input class="form-control" type="number" step="0.01" min="0" ng-model="line.unitPrice" name="Input.Lines[{{$index}}].UnitPrice" required /></td>
                            <td><button class="btn btn-sm btn-outline-danger" type="button" ng-click="removeLine($index)">Remove</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="form-action-row">
                <button type="button" class="btn btn-outline-primary" ng-click="addLine()">Add item</button>
                <button type="submit" class="btn btn-primary">Submit request</button>
                <button type="button" class="btn btn-light" ng-click="resetForm($event)">Reset</button>
                <a asp-action="Requests" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

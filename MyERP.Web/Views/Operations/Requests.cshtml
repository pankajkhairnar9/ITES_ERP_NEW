@model MyERP.Web.Models.OperationPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="page-intro">
    <p>Submit requirements and review requests before purchase ordering.</p>
    <div class="operations-page-actions"><a class="btn btn-primary" asp-action="NewRequest"><i class="mdi mdi-plus"></i> New request</a></div>
</div>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}
<div class="card operation-table-card">
    <div class="card-body">
        <div class="section-heading"><div><h2 class="section-title">Purchase requests</h2><p class="section-description">@Model.Rows.Count request(s)</p></div></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Request</th><th>Branch</th><th>Submitted</th><th>Status</th><th class="text-right">Action</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="font-weight-medium">@row.Number</td><td>@row.Branch</td><td>@row.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge text-bg-light status-pill">@row.Status</span></td>
                            <td class="text-right">
                                @if (row.Status == MyERP.Domain.WorkflowStatus.Submitted && User.HasClaim("permission", "purchase.approve"))
                                {
                                    <form asp-action="ReviewRequest" method="post" class="form-inline-action"><input type="hidden" name="id" value="@row.Id" /><input type="hidden" name="approve" value="true" /><button class="btn btn-sm btn-success">Approve</button></form>
                                    <form asp-action="ReviewRequest" method="post" class="form-inline-action"><input type="hidden" name="id" value="@row.Id" /><input type="hidden" name="approve" value="false" /><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="5" class="table-empty-state">No purchase requests yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
